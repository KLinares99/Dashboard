# Supabase project (Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose to the browser. Used to invite clients.
SUPABASE_SERVICE_ROLE_KEY=

# Public URL of the app, used in invite and sign-in links
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Drive (optional). A service account JSON key, as one line.
# Share each client's Drive folder with the service account's email (Viewer).
GOOGLE_SERVICE_ACCOUNT_JSON=
